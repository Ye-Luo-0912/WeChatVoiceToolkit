<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             xmlns:views="using:WeChatVoice.Desktop.Views"
             x:Class="WeChatVoice.Desktop.App">
  <Application.Styles>
    <FluentTheme />

    <!-- Keep the dark shell readable while allowing light status cards to
         opt into their own high-contrast foreground explicitly. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="Background" Value="#0B1220" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#1D4ED8" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#60A5FA" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="#334155" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="BorderBrush" Value="#475569" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#111827" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#475569" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:ResumeViewModel}">
      <views:ResumeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EnvironmentViewModel}">
      <views:EnvironmentView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SourceSnapshotViewModel}">
      <views:SourceSnapshotView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MaterializationViewModel}">
      <views:MaterializationView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ContactViewModel}">
      <views:ContactView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ScanViewModel}">
      <views:ScanView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExportViewModel}">
      <views:ExportView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DatasetCurationViewModel}">
      <views:DatasetCurationView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryDiagnosticsViewModel}">
      <views:HistoryDiagnosticsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StorageViewModel}">
      <views:StorageView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
