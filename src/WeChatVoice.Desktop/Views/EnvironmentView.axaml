<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             x:Class="WeChatVoice.Desktop.Views.EnvironmentView"
             x:DataType="vm:EnvironmentViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
      <ProgressBar IsVisible="{Binding RunHost.IsRunning}" IsIndeterminate="True" />
      <TextBlock Text="{Binding RunHost.StageMessage}" />
      <TextBlock Text="{Binding RunHost.LastError}" Foreground="Red" />
    </StackPanel>

    <StackPanel Spacing="16">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="环境检测" />
      <TextBlock Text="{Binding SupportedVersionText}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="360" PlaceholderText="可选：Workspace JSON 路径" Text="{Binding WorkspacePath}" />
        <Button Content="检测" Command="{Binding AssessCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding DetectionSummary}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding CapabilitySummary}" />
      <TextBlock Text="{Binding WorkspaceSummary}" />
      <StackPanel Orientation="Horizontal" Spacing="24">
        <TextBlock Text="{Binding WorkerInstalled, StringFormat='SQLCipher Worker：{0}'}" />
        <TextBlock Text="{Binding BrokerInstalled, StringFormat='Key Broker：{0}'}" />
        <TextBlock Text="{Binding BrokerAvailable, StringFormat='物料化可用：{0}'}" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</UserControl>
