<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="WeChatVoice.Desktop.Views.SourceSnapshotView"
             x:DataType="vm:SourceSnapshotViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
      <ProgressBar IsVisible="{Binding RunHost.IsRunning}" IsIndeterminate="True" />
      <TextBlock Text="{Binding RunHost.StageMessage}" />
      <TextBlock Text="{Binding RunHost.LastError}" Foreground="Red" />
    </StackPanel>

    <StackPanel Spacing="16">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="创建源快照" />
      <TextBlock Text="源目录为 Weixin 账号目录下的 db_storage（如 …\wxid_xxx_16hex\db_storage）。快照是后续所有步骤的可信输入。" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="350" PlaceholderText="源目录（db_storage）" Text="{Binding SourceDirectory}" />
        <Button Content="选择" Command="{Binding BrowseSourceCommand}" />
        <TextBox Width="350" PlaceholderText="输出目录" Text="{Binding OutputDirectory}" />
        <Button Content="选择" Command="{Binding BrowseOutputCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="正式流程仅接受稳定快照；活动源仅可通过高级诊断入口使用。" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="发现 Weixin 数据源" Command="{Binding DiscoverSourcesCommand}" IsEnabled="{Binding CanStartOperation}" />
          <ComboBox Width="520" ItemsSource="{Binding SourceCandidates}" SelectedItem="{Binding SelectedSourceCandidate}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding DbStoragePath}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <Button Content="创建快照" Command="{Binding CreateSnapshotCommand}" IsEnabled="{Binding CanStartOperation}" />
      </StackPanel>
      <TextBlock Text="{Binding PathValidationSummary}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SnapshotSummary}" FontWeight="SemiBold" />
      <TextBlock IsVisible="{Binding AccountCandidate, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                 Text="{Binding AccountCandidate, StringFormat='检测到账号候选：{0}'}" />
    </StackPanel>
  </DockPanel>
</UserControl>
