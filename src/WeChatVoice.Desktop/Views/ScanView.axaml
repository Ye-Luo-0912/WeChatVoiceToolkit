<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             x:Class="WeChatVoice.Desktop.Views.ScanView"
             x:DataType="vm:ScanViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <DockPanel Margin="28">
      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,18,0,0">
        <ProgressBar IsVisible="{Binding RunHost.IsRunning}"
                     IsIndeterminate="{Binding !RunHost.HasPercent}"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding RunHost.PercentCompleteOrZero}" />
        <TextBlock Text="{Binding RunHost.StageMessage}" TextWrapping="Wrap" Foreground="#93C5FD" />
        <TextBlock Text="{Binding RunHost.LastError}" Foreground="#FCA5A5" TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding HasDurationErrors}" Text="{Binding DurationErrorSummary}" Foreground="#FBBF24" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="18" MaxWidth="1080">
        <StackPanel Spacing="5">
          <TextBlock FontSize="26" FontWeight="SemiBold" Text="语音扫描" />
          <TextBlock Foreground="#94A3B8"
                     Text="先确认联系人，再设置范围。扫描只读数据库，不会写入或导出文件。"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Background="#172554"
                BorderBrush="#3B82F6"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
          <StackPanel Spacing="6">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="联系人" Foreground="#DBEAFE" />
            <TextBlock Text="{Binding ContactSelectionSummary}" Foreground="#FFFFFF" />
            <TextBlock IsVisible="{Binding NeedsContactSelection}"
                       Text="请先点击左侧“联系人”，加载并选择一位一对一联系人。"
                       Foreground="#BFDBFE"
                       TextWrapping="Wrap" />
            <TextBlock IsVisible="{Binding HasSelectedContact}"
                       Text="扫描和导出会固定使用该内部 username，不会按昵称猜测。"
                       Foreground="#BFDBFE"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding HasSelectedContact}" Spacing="16">
          <Border Background="#111827"
                  BorderBrush="#334155"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="16">
            <StackPanel Spacing="12">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="扫描范围" Foreground="#E2E8F0" />
              <TextBlock Text="{Binding WorkspacePath, StringFormat='Workspace：{0}'}" Foreground="#94A3B8" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                  <TextBlock Text="方向" Foreground="#94A3B8" />
                  <TextBox Text="仅对方发来的语音（incoming）" IsReadOnly="True" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                  <TextBlock Text="最大条数（可选）" Foreground="#94A3B8" />
                  <TextBox PlaceholderText="例如 500" Text="{Binding MaximumResultsText}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                  <TextBlock Text="起始 UTC 时间（可选）" Foreground="#94A3B8" />
                  <TextBox PlaceholderText="2025-01-01T00:00:00Z" Text="{Binding FromText}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                  <TextBlock Text="结束 UTC 时间（可选）" Foreground="#94A3B8" />
                  <TextBox PlaceholderText="2025-12-31T23:59:59Z" Text="{Binding ToText}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="8">
                  <CheckBox Content="深度扫描：读取并计算完整 Payload Hash" IsChecked="{Binding DeepScan}" />
                  <CheckBox Content="解析语音时长（较慢）" IsChecked="{Binding ResolveDurations}" IsEnabled="{Binding DurationAnalysisAvailable}" />
                </StackPanel>
              </Grid>

              <Border Background="#0F172A"
                      BorderBrush="#334155"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="时长解码器" FontWeight="SemiBold" Foreground="#E2E8F0" />
                  <TextBlock Text="{Binding DecoderStatusText}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="选择其他解码器…" Command="{Binding ConfigureDecoderCommand}" />
                    <Button Content="清除" Command="{Binding ClearDecoderConfigCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Background="#111827"
                  BorderBrush="#334155"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="16">
            <StackPanel Spacing="12">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="训练筛选（可选）" Foreground="#E2E8F0" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <TextBox Grid.Row="0" Grid.Column="0" PlaceholderText="最短时长 ms" Text="{Binding MinimumDurationMsText}" />
                <TextBox Grid.Row="0" Grid.Column="1" PlaceholderText="最长时长 ms" Text="{Binding MaximumDurationMsText}" />
                <TextBox Grid.Row="1" Grid.Column="0" PlaceholderText="最小大小 bytes" Text="{Binding MinimumPayloadBytesText}" />
                <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="最大大小 bytes" Text="{Binding MaximumPayloadBytesText}" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="开始扫描"
                    Command="{Binding ScanCommand}"
                    IsEnabled="{Binding CanStartOperation}"
                    Background="#2563EB"
                    FontWeight="SemiBold" />
            <Button Content="取消" Command="{Binding RunHost.CancelCommand}" IsVisible="{Binding RunHost.CanCancel}" />
            <Button Content="重试" Command="{Binding RunHost.RetryCommand}" IsVisible="{Binding RunHost.CanRetry}" />
          </StackPanel>

          <Border Background="#0F172A"
                  BorderBrush="#334155"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="16">
            <StackPanel Spacing="12">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="扫描结果" Foreground="#E2E8F0" />
              <TextBlock Text="{Binding ScanSummary}" Foreground="#CBD5E1" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AccountSummary}" Foreground="#94A3B8" />
              <TextBlock Text="{Binding TotalDurationMs, StringFormat='总时长：{0} ms'}" Foreground="#CBD5E1" />
              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="12">
                <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="匹配" Foreground="#94A3B8" /><TextBlock FontSize="22" FontWeight="Bold" Text="{Binding MatchedVoiceCount}" /></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1"><TextBlock Text="可导出" Foreground="#94A3B8" /><TextBlock FontSize="22" FontWeight="Bold" Text="{Binding ExportableVoiceCount}" /></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="疑似重复" Foreground="#94A3B8" /><TextBlock FontSize="22" FontWeight="Bold" Text="{Binding DuplicateCount}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Missing" Foreground="#94A3B8" /><TextBlock FontSize="20" Text="{Binding MissingCount}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Empty / Invalid" Foreground="#94A3B8" /><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock FontSize="20" Text="{Binding EmptyCount}" /><TextBlock FontSize="20" Text="/" /><TextBlock FontSize="20" Text="{Binding InvalidHeaderCount}" /></StackPanel></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Ambiguous" Foreground="#94A3B8" /><TextBlock FontSize="20" Text="{Binding AmbiguousCount}" /></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </ScrollViewer>
</UserControl>
