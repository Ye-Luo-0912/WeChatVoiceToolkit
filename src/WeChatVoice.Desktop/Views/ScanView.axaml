<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             x:Class="WeChatVoice.Desktop.Views.ScanView"
             x:DataType="vm:ScanViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
      <ProgressBar IsVisible="{Binding RunHost.IsRunning}" IsIndeterminate="True" />
      <TextBlock Text="{Binding RunHost.StageMessage}" />
      <TextBlock Text="{Binding RunHost.LastError}" Foreground="Red" />
    </StackPanel>

    <StackPanel Spacing="16">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="语音扫描（元数据审计）" />
      <TextBlock Text="只读审计，不写任何文件。仅支持一对一联系人；输出为原始 SILK 的关联状态。" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="340" PlaceholderText="Workspace JSON 路径" Text="{Binding WorkspacePath}" />
        <TextBlock Width="360" Text="联系人必须在联系人页显式选择" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Width="180" Text="仅对方发来的语音（incoming）" />
        <TextBox Width="180" PlaceholderText="起始 UTC 时间" Text="{Binding FromText}" />
        <TextBox Width="180" PlaceholderText="结束 UTC 时间" Text="{Binding ToText}" />
        <CheckBox Content="深度扫描（读取并 Hash 完整 Payload）" IsChecked="{Binding DeepScan}" />
        <TextBox Width="120" PlaceholderText="最大条数（可选）" Text="{Binding MaximumResultsText}" />
        <Button Content="扫描" Command="{Binding ScanCommand}" />
        <Button Content="取消" Command="{Binding RunHost.CancelCommand}" IsVisible="{Binding RunHost.CanCancel}" />
        <Button Content="重试" Command="{Binding RunHost.RetryCommand}" IsVisible="{Binding RunHost.CanRetry}" />
      </StackPanel>
      <TextBlock Text="{Binding AccountSummary}" />
      <TextBlock Text="{Binding ScanSummary}" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="24">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="匹配" />
          <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding MatchedVoiceCount}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Missing" />
          <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding MissingCount}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="Empty" />
          <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding EmptyCount}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Spacing="4">
          <TextBlock Text="InvalidHeader" />
          <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding InvalidHeaderCount}" />
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="4">
          <TextBlock Text="Ambiguous" />
          <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding AmbiguousCount}" />
        </StackPanel>
        <StackPanel Grid.Column="5" Spacing="4">
          <TextBlock Text="疑似重复" />
          <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding DuplicateCount}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </DockPanel>
</UserControl>
