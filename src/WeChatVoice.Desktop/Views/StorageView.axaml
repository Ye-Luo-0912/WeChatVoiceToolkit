<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             xmlns:core="using:WeChatVoice.Core.Models"
             x:Class="WeChatVoice.Desktop.Views.StorageView"
             x:DataType="vm:StorageViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="存储管理" />
      <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="刷新占用" Command="{Binding RefreshInventoryCommand}" IsEnabled="{Binding CanStartOperation}" />
        <Button Content="清理预检" Command="{Binding PreviewCleanupCommand}" IsEnabled="{Binding CanStartOperation}" />
        <Button Content="执行清理（再次点击确认）" Command="{Binding CleanupCommand}" IsEnabled="{Binding CanStartOperation}" />
      </StackPanel>
      <TextBlock Text="{Binding CleanupSummary}" Foreground="#A33A00" TextWrapping="Wrap" />
    </StackPanel>

    <DockPanel>
      <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="应用自有存储对象" Margin="0,0,0,6" />
      <ListBox ItemsSource="{Binding Assets}" MaxHeight="420">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:StorageAssetRecord">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Path}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="2" Text="{Binding TotalBytes, StringFormat='{}{0} bytes'}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>