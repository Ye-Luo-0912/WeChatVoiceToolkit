<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             x:Class="WeChatVoice.Desktop.Views.MaterializationView"
             x:DataType="vm:MaterializationViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
      <ProgressBar IsVisible="{Binding RunHost.IsRunning}" IsIndeterminate="True" />
      <TextBlock Text="{Binding RunHost.StageMessage}" />
      <TextBlock Text="{Binding RunHost.LastError}" Foreground="Red" />
      <Border IsVisible="{Binding IsUacRejected}" Background="#FFD9C7" CornerRadius="4" Padding="8">
        <TextBlock Text="UAC 管理员授权被拒绝。请重试并在系统提示中点击「是」。" />
      </Border>
    </StackPanel>

    <!-- Keep the safety confirmation above the form. The workflow deliberately
         pauses here until the user confirms the detected Weixin account. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsConfirmDialogOpen}"
            Background="#EEF2F7"
            CornerRadius="6"
            Padding="16"
            Margin="0,12,0,0"
            VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <TextBlock Foreground="#102A43" FontWeight="SemiBold" Text="确认账号身份（流程正在等待此操作）" />
        <TextBlock Foreground="#102A43" Text="{Binding PendingAccountCandidate, StringFormat='检测到账号：{0}'}" />
        <TextBlock Foreground="#102A43" Text="请确认这是您自己的 Weixin 账号。确认后才会继续并弹出 UAC；如果不是，请点击拒绝或取消。" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="确认" Command="{Binding ConfirmAccountCommand}"
                  Background="#1565A8" Foreground="#FFFFFF" BorderBrush="#0D47A1" />
          <Button Content="拒绝" Command="{Binding DeclineAccountCommand}"
                  Background="#B42318" Foreground="#FFFFFF" BorderBrush="#7A271A" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16" MinWidth="720">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="物料化（解密数据库）" />
        <TextBlock Text="快照完成后会自动填充快照目录、Workspace 输出目录和 JSON 路径。点击开始后，Key Broker 会弹出 UAC 授权并确认账号。" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="380" PlaceholderText="快照目录" Text="{Binding SnapshotDirectory}" />
          <Button Content="选择快照" Command="{Binding BrowseSnapshotCommand}" />
          <TextBox Width="380" PlaceholderText="物料化输出目录" Text="{Binding OutputDirectory}" />
          <Button Content="选择输出目录" Command="{Binding BrowseOutputCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="380" PlaceholderText="可选：Workspace JSON 输出路径" Text="{Binding WorkspaceOutputPath}" />
          <TextBox Width="380" PlaceholderText="可选：显式确认的账号（wxid_…）" Text="{Binding RequestedAccount}" />
        </StackPanel>
        <Border Background="#E8F1FF" CornerRadius="6" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock Foreground="#102A43" FontWeight="SemiBold" Text="密钥提取前置条件" />
            <TextBlock Foreground="#243B53" Text="{Binding WeixinProcessSummary}" TextWrapping="Wrap" />
            <TextBlock Foreground="#243B53" Text="创建源快照时需要退出 Weixin；现在请重新启动 Weixin，工具只会进行受控的只读身份验证和密钥提取。" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Button Content="刷新 Weixin 状态" Command="{Binding RefreshWeixinStateCommand}"
                  Background="#2F6F9F" Foreground="#FFFFFF" BorderBrush="#8CC8F0" />
          <Button Content="开始物料化" Command="{Binding MaterializeCommand}" IsEnabled="{Binding CanStartMaterialization}"
                  Background="#1565A8" Foreground="#FFFFFF" BorderBrush="#8CC8F0" />
          <Button Content="恢复 Workspace（不重新解密）" Command="{Binding RecoverMaterializationCommand}" IsVisible="{Binding CanRecoverMaterialization}" IsEnabled="{Binding CanStartOperation}" />
          <Button Content="取消" Command="{Binding RunHost.CancelCommand}" IsVisible="{Binding RunHost.CanCancel}" />
          <Button Content="重试" Command="{Binding RunHost.RetryCommand}" IsVisible="{Binding RunHost.CanRetry}" />
        </StackPanel>
        <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding IdentitySummary}" />
        <TextBlock Text="{Binding RecoverySummary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding MaterializationReadinessSummary}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
