<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             x:Class="WeChatVoice.Desktop.Views.DatasetCurationView"
             x:DataType="vm:DatasetCurationViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <ProgressBar IsVisible="{Binding RunHost.IsRunning}" Value="{Binding RunHost.PercentComplete}" Minimum="0" Maximum="100" />
      <TextBlock Text="{Binding RunHost.StageMessage}" />
      <TextBlock Text="{Binding RunHost.LastError}" Foreground="Red" />
    </StackPanel>

    <StackPanel Spacing="12">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="数据集整理（明确选择训练集）" />
      <TextBlock Text="筛选只影响候选项；成功导出不会自动成为训练样本。重复组只能选择一个代表项，原始 SILK 不会被修改。" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="360" IsReadOnly="True" Text="{Binding ExportDirectory}" PlaceholderText="导出目录" />
        <TextBox Width="360" Text="{Binding DatasetOutputDirectory}" PlaceholderText="训练数据集输出目录（留空则按 Fingerprint）" />
        <TextBox Width="100" Text="{Binding MinimumDurationMsText}" PlaceholderText="最短 ms" />
        <TextBox Width="100" Text="{Binding MaximumDurationMsText}" PlaceholderText="最长 ms" />
        <TextBox Width="110" Text="{Binding MinimumByteLengthText}" PlaceholderText="最小字节" />
        <TextBox Width="110" Text="{Binding MaximumByteLengthText}" PlaceholderText="最大字节" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox Content="显示未知时长（不可选入训练集）" IsChecked="{Binding ShowUnknownDuration}" />
        <ComboBox ItemsSource="{Binding DirectionScopes}" SelectedIndex="{Binding DirectionScopeIndex}" Width="110" />
        <TextBox Width="360" Text="{Binding ExcludedQualityFlagsText}" PlaceholderText="排除质量标志（逗号分隔）" />
        <Button Content="应用筛选 / 加载" Command="{Binding LoadCommand}" IsEnabled="{Binding CanStartOperation}" />
        <Button Content="加载 Profile" Command="{Binding LoadProfileCommand}" IsEnabled="{Binding CanStartOperation}" />
        <Button Content="保存 Profile" Command="{Binding SaveProfileCommand}" IsEnabled="{Binding CanStartOperation}" />
        <Button Content="清除选择" Command="{Binding ClearSelectionsCommand}" IsEnabled="{Binding CanStartOperation}" />
        <Button Content="停止试听" Command="{Binding StopPreviewCommand}" IsEnabled="{Binding CanStartOperation}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="WAV 构建：" VerticalAlignment="Center" />
        <TextBox Width="90" Text="{Binding SampleRateText}" PlaceholderText="采样率" />
        <CheckBox Content="单声道" IsChecked="{Binding Mono}" VerticalAlignment="Center" />
        <Button Content="构建训练数据集" Command="{Binding BuildDatasetCommand}" IsEnabled="{Binding CanStartOperation}" />
        <Button Content="验证数据集" Command="{Binding VerifyDatasetCommand}" IsEnabled="{Binding CanStartOperation}" />
        <Button Content="修复数据集元数据" Command="{Binding RepairDatasetCommand}" IsEnabled="{Binding CanStartOperation}" />
        <TextBox Width="120" Text="{Binding DeleteConfirmationText}" PlaceholderText="输入 DELETE" />
        <Button Content="删除派生数据集" Command="{Binding DeleteDatasetCommand}" IsEnabled="{Binding CanStartOperation}" />
      </StackPanel>
      <TextBlock Text="{Binding CurationSummary}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" />
      <TextBlock Text="当前选择尚未保存；构建时会自动保存" IsVisible="{Binding SelectionDirty}" Foreground="DarkOrange" />
      <TextBlock Text="{Binding BuildSummary}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="24">
        <TextBlock Text="{Binding SelectedCount, StringFormat='已选：{0} 条'}" />
        <TextBlock Text="{Binding SelectedDurationMs, StringFormat='训练总时长：{0} ms'}" />
        <TextBlock Text="{Binding SelectedByteLength, StringFormat='训练总大小：{0} bytes'}" />
      </StackPanel>

      <ListBox ItemsSource="{Binding Items}" Height="430">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DatasetCurationItemViewModel">
            <Grid ColumnDefinitions="40,170,230,80,90,90,180,150,60,*" Margin="2">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
              <TextBlock Grid.Column="1" Text="{Binding ItemId}" />
              <TextBlock Grid.Column="2" Text="{Binding RelativeAudioPath}" />
              <TextBlock Grid.Column="3" Text="{Binding DurationText}" />
              <TextBlock Grid.Column="4" Text="{Binding ByteLength}" />
              <TextBlock Grid.Column="5" Text="{Binding Direction}" />
              <TextBlock Grid.Column="6" Text="{Binding QualityFlags}" />
              <TextBlock Grid.Column="7" Text="{Binding DuplicateGroupId}" />
              <TextBlock Grid.Column="8" Text="{Binding TrainingEligibility}" />
              <Button Grid.Column="9" Content="{Binding PreviewButtonText}" Command="{Binding PreviewCommand}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </DockPanel>
</UserControl>
