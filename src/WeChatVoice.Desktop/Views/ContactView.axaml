<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeChatVoice.Desktop.ViewModels"
             xmlns:models="using:WeChatVoice.Core.Models"
             x:Class="WeChatVoice.Desktop.Views.ContactView"
             x:DataType="vm:ContactViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
      <ProgressBar IsVisible="{Binding RunHost.IsRunning}" IsIndeterminate="True" />
      <TextBlock Text="{Binding RunHost.StageMessage}" />
      <TextBlock Text="{Binding RunHost.LastError}" Foreground="Red" />
    </StackPanel>

    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="联系人发现" />
        <TextBlock Text="仅列出稳定的一对一联系人（群聊已排除）。导出与扫描只接受精确的内部用户名。" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="380" IsReadOnly="True" PlaceholderText="当前 Workspace JSON（由项目会话提供）" Text="{Binding WorkspacePath}" />
          <TextBox Width="280" PlaceholderText="搜索：用户名 / 微信 ID / 备注 / 昵称" Text="{Binding SearchTerm}" />
          <Button Content="加载" Command="{Binding LoadContactsCommand}" IsEnabled="{Binding CanStartOperation}" />
        </StackPanel>
        <TextBlock Text="{Binding AccountSummary}" />
        <TextBlock Text="{Binding ContactSummary}" />
        <Border IsVisible="{Binding HasSelectedContact}"
                Background="#164E78"
                BorderBrush="#60A5FA"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{Binding SelectedContactSummary}"
                       Foreground="#FFFFFF"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="清除选择"
                    Command="{Binding ClearSelectionCommand}"
                    Background="#0F3554"
                    Foreground="#FFFFFF" />
          </Grid>
        </Border>
        <TextBlock IsVisible="{Binding HasSelectedContact}"
                   Text="已锁定联系人。点击左侧“语音扫描”继续，扫描和导出将始终使用这个 username。"
                   Foreground="#93C5FD"
                   TextWrapping="Wrap" />
      </StackPanel>

      <ListBox ItemsSource="{Binding Contacts}"
               SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
               SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:ContactRecord">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="{Binding DisplayName}" Width="180" />
              <TextBlock Text="{Binding Remark}" Width="180" />
              <TextBlock Text="{Binding Nickname}" Width="180" />
              <TextBlock Text="{Binding ContactId}" Width="240" />
              <TextBlock Text="{Binding Username}" Width="240" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
