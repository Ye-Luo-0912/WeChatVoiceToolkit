<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeChatVoice.Core\WeChatVoice.Core.csproj" />
    <ProjectReference Include="..\WeChatVoice.Infrastructure\WeChatVoice.Infrastructure.csproj" />
    <ProjectReference Include="..\WeChatVoice.KeyAcquisition\WeChatVoice.KeyAcquisition.csproj" />
    <ProjectReference Include="..\WeChatVoice.Windows\WeChatVoice.Windows.csproj" />
    <ProjectReference Include="..\WeChatVoice.SqlCipherWorker\WeChatVoice.SqlCipherWorker.csproj" />
  </ItemGroup>

  <Target Name="GenerateSqlCipherWorkerBundleManifest" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\GenerateWorkerBundleManifest.ps1&quot; -Directory &quot;$(TargetDir)&quot;" />
  </Target>

</Project>
