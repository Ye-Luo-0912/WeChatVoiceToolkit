<Project>
  <!--
    Shared deployment targets: build the elevated Key Broker project and copy
    the Broker, SQLCipher Worker, provider, and native e_sqlcipher binaries into
    the host output directory so the trust policy's "adjacent file" contract and
    the bundle-manifest generation work for every host (CLI, Desktop).
  -->
  <PropertyGroup>
    <KeyBrokerOutputPath>..\WeChatVoice.KeyBroker\bin\$(Configuration)\net10.0\</KeyBrokerOutputPath>
    <KeyBrokerOutputPath Condition="'$(RuntimeIdentifier)' != ''">..\WeChatVoice.KeyBroker\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\</KeyBrokerOutputPath>
  </PropertyGroup>

  <Target Name="BuildKeyBroker" BeforeTargets="CopyKeyBroker;CopyKeyBrokerToPublish">
    <!-- The release entry point restores the solution once with the target
         RID. A nested Restore here defeats the no-restore publish contract
         and can silently produce a different lock graph. -->
    <MSBuild Projects="..\WeChatVoice.KeyBroker\WeChatVoice.KeyBroker.csproj" Targets="Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);Restore=false" />
  </Target>

  <Target Name="CopyKeyBroker" AfterTargets="Build">
    <ItemGroup>
      <KeyBrokerFiles Include="$(KeyBrokerOutputPath)WeChatVoice.KeyBroker*" />
      <SqlCipherWorkerFiles Include="$(KeyBrokerOutputPath)WeChatVoice.SqlCipherWorker*" />
      <SqlCipherProviderFiles Include="$(KeyBrokerOutputPath)SQLitePCLRaw.provider.e_sqlcipher.dll" />
      <SqlCipherNativeFiles Include="$(KeyBrokerOutputPath)runtimes\win-x64\native\e_sqlcipher.dll" Condition="'$(RuntimeIdentifier)' == ''" />
      <SqlCipherNativeFiles Include="$(KeyBrokerOutputPath)e_sqlcipher.dll" Condition="'$(RuntimeIdentifier)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(KeyBrokerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SqlCipherWorkerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SqlCipherProviderFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SqlCipherNativeFiles)" DestinationFolder="$(OutDir)runtimes\win-x64\native" SkipUnchangedFiles="true" />
  </Target>

  <!--
    CopyKeyBroker is the final deployment step of a normal Host build. The
    Worker manifest generated by the Key Broker project describes that
    project's private output, not the Host output after the Broker, Worker,
    provider, and native files have been copied into it. Rebuild the manifest
    against the actual Host directory so the runtime verifies the bytes it
    will load.
  -->
  <Target Name="GenerateHostWorkerBundleManifest"
          AfterTargets="CopyKeyBroker"
          Condition="'$(OutDir)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)GenerateWorkerBundleManifest.ps1&quot; -Directory &quot;$(OutDir)&quot;" />
  </Target>

  <Target Name="CopyKeyBrokerToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <PublishedKeyBrokerFiles Include="$(KeyBrokerOutputPath)WeChatVoice.KeyBroker*" />
      <PublishedSqlCipherWorkerFiles Include="$(KeyBrokerOutputPath)WeChatVoice.SqlCipherWorker*" />
      <PublishedSqlCipherProviderFiles Include="$(KeyBrokerOutputPath)SQLitePCLRaw.provider.e_sqlcipher.dll" />
      <PublishedSqlCipherNativeFiles Include="$(KeyBrokerOutputPath)e_sqlcipher.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedKeyBrokerFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishedSqlCipherWorkerFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishedSqlCipherProviderFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishedSqlCipherNativeFiles)" DestinationFolder="$(PublishDir)runtimes\win-x64\native" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish has the same final-copy boundary as Build. Keep the published
       Host manifest authoritative even when a Host is published directly. -->
  <Target Name="GeneratePublishedHostWorkerBundleManifest"
          AfterTargets="CopyKeyBrokerToPublish"
          Condition="'$(PublishDir)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)GenerateWorkerBundleManifest.ps1&quot; -Directory &quot;$(PublishDir)&quot;" />
  </Target>
</Project>
